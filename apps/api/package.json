{
  "name": "@reveal/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "db:init": "tsx --env-file-if-exists=../../.env src/cli/init-db.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/cli/seed.ts",
    "admin:create": "tsx --env-file-if-exists=../../.env src/cli/create-admin.ts",
    "media:import-portrait": "tsx --env-file-if-exists=../../.env src/cli/import-portrait.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@reveal/shared": "1.0.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "mongoose": "^8.16.1",
    "multer": "^2.0.1",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.34.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.15.32",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3"
  }
}
