[Unit]
Description=THE REVEAL API
After=network.target mongod.service

[Service]
Type=simple
User=reveal
Group=reveal
WorkingDirectory=/srv/the-reveal/app/apps/api
ExecStart=/usr/bin/node --env-file=/srv/the-reveal/app/.env dist/server.js
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/the-reveal/uploads

[Install]
WantedBy=multi-user.target
