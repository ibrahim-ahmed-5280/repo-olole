# THE REVEAL — production environment (/etc/the-reveal/api.env, root:reveal 0640)
# Generated by deploy/vps/10-prepare.sh. NEVER commit the real file.
# Values must stay shell-safe (no spaces/quotes) because backup cron jobs source this file.

NODE_ENV=production
HOST=127.0.0.1
PORT=@PORT@

# Set by deploy/vps/15-mongodb.sh (dedicated user with readWrite on @DB@ only)
MONGODB_URI=mongodb://REPLACE_ME@127.0.0.1:27017/@DB@?authSource=@DB@

# Public site. During SSH-tunnel staging, ALLOWED_ORIGINS also contains http://localhost:@PORT@
# (removed again after cutover — see docs/NGINX_CUTOVER.md).
PUBLIC_ORIGIN=https://@DOMAIN@
ALLOWED_ORIGINS=https://@DOMAIN@,http://localhost:@PORT@

ANALYTICS_SECRET=@ANALYTICS_SECRET@

SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
COOKIE_SECURE=true
TRUST_PROXY=1

UPLOAD_DIR=@UPLOADS@
MAX_UPLOAD_MB=8

FEEDBACK_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730
ANALYTICS_RETENTION_DAYS=730
LOG_LEVEL=info

# Node serves the built SPA (index.html + SPA fallback); Nginx serves /assets directly.
SERVE_WEB=true
WEB_DIST_DIR=@APP@/apps/web/dist

# Build-time (public, baked into the web bundle — never put secrets in VITE_*)
VITE_API_BASE=/api/v1
VITE_SITE_URL=https://@DOMAIN@
