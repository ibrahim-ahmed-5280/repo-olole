# THE REVEAL — example Nginx site (HTTPS added by certbot). Replace example.org.
limit_req_zone $binary_remote_addr zone=reveal_feedback:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=reveal_login:10m rate=5r/m;

upstream reveal_api {
    server 127.0.0.1:4000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name example.org;

    root /srv/the-reveal/app/apps/web/dist;
    index index.html;

    client_max_body_size 10m;
    server_tokens off;
    access_log off;   # the API logs requests itself, without IP addresses

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/xml;

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /api/v1/feedback {
        limit_req zone=reveal_feedback burst=3 nodelay;
        proxy_pass http://reveal_api;
        include /etc/nginx/proxy_params;
    }

    location = /api/v1/admin/auth/login {
        limit_req zone=reveal_login burst=3 nodelay;
        proxy_pass http://reveal_api;
        include /etc/nginx/proxy_params;
    }

    location ~ ^/(api/|media/|robots\.txt$|sitemap\.xml$) {
        proxy_pass http://reveal_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        include /etc/nginx/proxy_params;   # Host, X-Real-IP, X-Forwarded-For, X-Forwarded-Proto
    }

    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" always;
        try_files $uri /index.html;
    }
}
