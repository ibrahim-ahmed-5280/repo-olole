# ─────────────────────────────────────────────────────────────
# THE REVEAL — environment configuration (copy to .env)
# Never commit real values. All values below are examples.
# ─────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development

# API listen address
HOST=127.0.0.1
PORT=4000

# MongoDB connection string (use a dedicated database + least-privilege user in production)
MONGODB_URI=mongodb://127.0.0.1:27017/the_reveal

# Public origin(s) of the website, comma separated. Used for the CORS allowlist,
# Origin checks on admin mutations, canonical URLs and the sitemap.
PUBLIC_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Long random secret (>= 32 chars) used for daily-rotating analytics session hashing.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ANALYTICS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Admin session lifetime (hours) and idle timeout (minutes)
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# Set to true when served over HTTPS (required in production)
COOKIE_SECURE=false

# Where uploaded media is stored (outside the web root of other applications)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# Data retention (days)
FEEDBACK_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730
ANALYTICS_RETENTION_DAYS=730

# Logging: fatal | error | warn | info | debug
LOG_LEVEL=info

# Trust proxy hops (set to 1 behind Nginx so rate limiting sees the client)
TRUST_PROXY=0

# Serve the built web app from the API process (single-process deployment)
SERVE_WEB=false
WEB_DIST_DIR=../web/dist

# Web (Vite) build-time variables
VITE_API_BASE=/api/v1
VITE_SITE_URL=http://localhost:5173
